QRFORGE_PUBLIC_URL=https://qr.example.com
QRFORGE_DB_PATH=/var/lib/qrforge/qrforge.db
QRFORGE_OIDC_CLIENT_ID=
QRFORGE_OIDC_CLIENT_SECRET=
QRFORGE_OIDC_REDIRECT_URI=https://qr.example.com/api/auth/callback
QRFORGE_OIDC_PUBLIC_BASE=https://auth.example.com
# Defaults to PUBLIC_BASE; loopback HTTP is allowed for an internal provider.
#QRFORGE_OIDC_INTERNAL_BASE=http://127.0.0.1:9100
#QRFORGE_OIDC_APP_SLUG=qr-forge
#QRFORGE_OIDC_TIMEOUT_MS=10000
# Host público contra el que compara el guardián de origen. Sin fijar usa el `Host` que
# llega, que es lo correcto detrás de un túnel que lo conserva. Sólo hace falta si
# el proxy lo reescribe con un nombre interno.
#QRFORGE_PUBLIC_HOST=qr.example.com
#QRFORGE_SESSION_TTL_HOURS=12
#QRFORGE_MAX_QRS_PER_USER=1000
#QRFORGE_MAX_CREATES_PER_HOUR=120
#QRFORGE_SCAN_RETENTION_DAYS=365

# La página de la cuenta en tu proveedor: correo, contraseña, segundo factor, sesiones.
# Nada de eso lo lleva esta aplicación. Sin la variable, el menú de cuenta no enlaza a
# ningún sitio. La ruta es de cada proveedor; Authentik la sirve en /if/user/.
#QRFORGE_ACCOUNT_URL=https://auth.example.com/if/user/
