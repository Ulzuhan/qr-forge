[Unit]
Description=QR Forge
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=qrforge
Group=qrforge
WorkingDirectory=/opt/qr-forge
EnvironmentFile=/etc/qr-forge.env
Environment=HOSTNAME=127.0.0.1
Environment=PORT=3459
Environment=QRFORGE_DB_PATH=/var/lib/qrforge/qrforge.db
# Sin ExecStartPre: la inicialización de la base la hace el propio binario, que
# además nunca reinicializa una base existente. Node ya no interviene en el
# arranque.
ExecStart=/opt/qr-forge/qrforge
Restart=on-failure
RestartSec=5
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/qrforge
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
RestrictRealtime=true
SystemCallArchitectures=native
MemoryMax=512M
TasksMax=256
CPUQuota=150%
TimeoutStopSec=10
KillMode=control-group

[Install]
WantedBy=multi-user.target
