{
  "name": "qr-forge",
  "version": "0.6.0",
  "description": "Dynamic and static QR codes, self-hosted: the printed code never changes, you change where it points — with privacy-minimized scan analytics.",
  "license": "MIT",
  "author": "Ulzuhan",
  "repository": {
    "type": "git",
    "url": "https://github.com/Ulzuhan/qr-forge.git"
  },
  "keywords": [
    "qr-code",
    "dynamic-qr",
    "analytics",
    "self-hosted",
    "sqlite",
    "golang",
    "react",
    "vite"
  ],
  "private": true,
  "scripts": {
    "dev": "npm run build && bash scripts/dev.sh",
    "build": "npm run build:web && go build -trimpath -o qrforge ./cmd/qrforge",
    "start": "./qrforge",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "build:web": "vite build",
    "test": "npm run build && npm run test:unit && npm run test:go && npm run test:http && npm run test:backchannel",
    "test:unit": "vitest run",
    "test:go": "go test -race ./cmd/... ./internal/...",
    "test:http": "bash scripts/run-suites.sh",
    "test:backchannel": "bash scripts/test-backchannel.sh",
    "test:navegador": "bash scripts/test-navegador.sh",
    "test:compatibilidad": "bash scripts/test-compatibilidad.sh"
  },
  "dependencies": {
    "qrcode": "^1.5.4",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "6.1.1",
    "eslint": "^9",
    "jsqr": "^1.4.0",
    "pngjs": "^7.0.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vite": "8.2.2",
    "vitest": "^4.1.11",
    "@eslint/js": "^9.39.4",
    "typescript-eslint": "^8.60.1",
    "eslint-plugin-react-hooks": "^7.1.1"
  },
  "overrides": {
    "postcss": "^8.5.18",
    "nanoid": "3.3.18",
    "js-yaml": "^4.3.1",
    "brace-expansion": "^2.0.2"
  }
}
